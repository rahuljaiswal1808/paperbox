{
  "name": "paperbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A complete PDF workspace that runs on your machine — local-first, offline-capable PDF editing.",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "sample": "node scripts/make-sample.mjs",
    "smoke": "npm run build && npm run sample && node scripts/serve-and-test.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.8.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
